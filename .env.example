# Config pública (usada por el frontend con Vite)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...

# === Config SOLO para scripts server-side (import-exercises) ===
# Dejar en .env.local (gitignored) — nunca en .env
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# === Supabase MCP (consumido por .mcp.json de Claude Code) ===
# Personal Access Token generado en https://supabase.com/dashboard/account/tokens
# NO es el anon key ni el service_role; es un PAT de tu cuenta.
# SUPABASE_ACCESS_TOKEN=sbp_...

# Opcional: traducción de instrucciones a ES en el importador
# IMPORT_TRANSLATE=1
#
# Usá UNA de estas dos (la que encuentre primero se usa):
# DEEPL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx   ← gratis, 500k chars/mes
# ANTHROPIC_API_KEY=sk-ant-...                             ← ~$2 one-shot con Haiku 4.5
