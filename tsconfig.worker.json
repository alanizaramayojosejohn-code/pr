{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": ["src/sw.ts"],
  "compilerOptions": {
    "lib": ["ES2022", "WebWorker"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo"
  }
}
